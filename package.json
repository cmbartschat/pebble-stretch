{
    "author": "Christoph Bartschat",
    "dependencies": {
        "pebble-clay": "^1.0.0"
    },
    "description": "Minimalist watchface with animated digits",
    "keywords": [
        "pebble-app"
    ],
    "name": "stretch",
    "prettier": {
        "singleQuote": true,
        "semi": false,
        "bracketSpacing": false,
        "trailingComma": "es5"
    },
    "pebble": {
        "capabilities": [
            "configurable"
        ],
        "displayName": "Stretch",
        "enableMultiJS": true,
        "messageKeys": [
            "CONFIG_BACKGROUND_COLOR",
            "CONFIG_DIGIT_0_COLOR",
            "CONFIG_DIGIT_1_COLOR",
            "CONFIG_DIGIT_2_COLOR",
            "CONFIG_DIGIT_3_COLOR"
        ],
        "projectType": "native",
        "resources": {
            "media": []
        },
        "sdkVersion": "3",
        "targetPlatforms": [
            "emery"
        ],
        "uuid": "d6d54026-9344-4717-afb1-d006c72f2471",
        "watchapp": {
            "watchface": true
        }
    },
    "version": "1.0.1"
}
